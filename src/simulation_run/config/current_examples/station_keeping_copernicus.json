{
  "_comment": [
    "BlueROV2 station-keeping at 10 m depth under a measured current",
    "depth-profile replay (copernicus_demo_profile.csv, a synthetic demo",
    "profile, alongside this file)."
  ],
  "world_file": "bluerov_ekman.world",
  "bluerov_current": "copernicus",
  "renderer_unity": true,
  "record_csv": true,
  "agents": [
    {
      "id": "bluerov_station_keeping",
      "class": "Bluerov2_heavy_current",
      "nb_agents": 1,
      "xdyn": true,
      "spawn": { "x": 0.0, "y": 0.0, "z": -10.0, "yaw": 0.0 },
      "tick_rate_hz": 1.0,
      "missions": [
        { "id": "navigation", "type": "action", "task": "bluerov_navigation", "params": {} },
        { "id": "hold", "type": "action", "task": "bluerov_guidance_hold",
          "params": { "z_setpoint_m": 10.0, "psi_setpoint_deg": 0.0, "hold_origin": true } },
        { "id": "control", "type": "action", "task": "bluerov_control", "params": {} },
        { "id": "allocation", "type": "action", "task": "bluerov_allocation", "params": {} },
        { "id": "metrics", "type": "action", "task": "bluerov_metrics_recorder",
          "params": { "output_dir": "results/current_examples", "run_name": "station_keeping_copernicus" } }
      ],
      "copernicus_current": { "profile": "copernicus_demo_profile.csv" }
    }
  ]
}
