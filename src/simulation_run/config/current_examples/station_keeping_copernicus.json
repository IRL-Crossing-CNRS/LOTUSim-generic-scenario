{
  "_comment": [
    "Same as station_keeping_ekman.json, but the current is a measured",
    "depth-profile replay injected by physics_engine_interface -- see",
    "'copernicus_current' below and current_examples/README.md.",
    "",
    "The profile path resolves relative to this config file's own",
    "directory, NOT the repo root and NOT CONFIG_DIR.",
    "copernicus_demo_profile.csv, alongside this file, is a small SYNTHETIC",
    "demo profile, not real Copernicus Marine Service data -- see the paper",
    "repo (LOTUSim_current_modelling_evaluation) for measured profiles."
  ],
  "world_file": "bluerov_ekman.world",
  "bluerov_current": "copernicus",
  "renderer_unity": true,
  "agents": [
    {
      "id": "bluerov_station_keeping",
      "class": "Bluerov2_heavy_pid",
      "nb_agents": 1,
      "xdyn": true,
      "spawn": { "x": 0.0, "y": 0.0, "z": -10.0, "yaw": 0.0 },
      "tick_rate_hz": 1.0,
      "missions": [
        { "id": "navigation", "type": "action", "task": "bluerov_navigation", "params": {} },
        { "id": "hold", "type": "action", "task": "bluerov_guidance_hold",
          "params": { "z_setpoint_m": 10.0, "psi_setpoint_deg": 0.0, "hold_origin": true } },
        { "id": "control", "type": "action", "task": "bluerov_control", "params": {} },
        { "id": "allocation", "type": "action", "task": "bluerov_allocation", "params": {} },
        { "id": "metrics", "type": "action", "task": "bluerov_metrics_recorder",
          "params": { "output_dir": "results/current_examples", "run_name": "station_keeping_copernicus" } }
      ],
      "copernicus_current": { "profile": "copernicus_demo_profile.csv" }
    }
  ]
}
