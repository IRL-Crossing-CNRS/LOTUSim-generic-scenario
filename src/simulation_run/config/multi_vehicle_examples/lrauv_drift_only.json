{
  "_comment": [
    "LRAUV, real xdyn dynamics, drift-only: no Guidance/Control feedback",
    "loop. The propeller is held at a fixed near-idle command (15 rpm)",
    "rather than 0, since the propeller's Kt(J)/Kq(J) curve divides by",
    "the commanded rpm and a literal 0 crashes xdyn."
  ],
  "world_file": "energy.world",
  "renderer_unity": true,
  "record_csv": true,
  "agents": [
    {
      "id": "lrauv_drift_only",
      "class": "Lrauv",
      "nb_agents": 1,
      "xdyn": true,
      "spawn": { "x": 0.0, "y": 0.0, "z": -10.0, "yaw": 0.0 },
      "tick_rate_hz": 1.0,
      "missions": [
        { "id": "navigation", "type": "action", "task": "navigation", "params": {} },
        { "id": "allocation", "type": "action", "task": "static_command_allocation",
          "params": { "commands": { "propeller(rpm)": 15.0, "propeller(P/D)": 0.88 } } }
      ]
    }
  ]
}
